# ─── Local development ──────────────────────────────────────────────────────
# Set DEV_AUTH_BYPASS=true to skip Google OAuth entirely.
# The frontend sends x-teacher-id automatically; no credentials needed.
# Never set this in production.
DEV_AUTH_BYPASS=true

SESSION_SECRET=local-dev-secret
CLIENT_URL=http://localhost:3000
NODE_ENV=development
PORT=5000

# Omit DATABASE_URL to use the local SQLite file (database.db)
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ─── Production only ────────────────────────────────────────────────────────
# DEV_AUTH_BYPASS=    # leave unset (defaults to false)
# SESSION_SECRET=<strong-random-secret>
# DATABASE_URL=<railway-postgres-url>
# CLIENT_URL=<your-deployed-frontend-url>

# ─── Google OAuth (skip in dev, required in production) ─────────────────────
GOOGLE_CLIENT_ID=your_client_id
GOOGLE_CLIENT_SECRET=your_client_secret_from_google_cloud
CALLBACK_URL=http://localhost:5000/auth/google/callback