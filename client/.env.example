# ─── Local development ──────────────────────────────────────────────────────
# Set REACT_APP_DEV_AUTH=true to show the dev login screen instead of Google OAuth.
# Must match DEV_AUTH_BYPASS=true on the server.
REACT_APP_DEV_AUTH=true

REACT_APP_API_BASE_URL=http://localhost:5000

# ─── Production only ────────────────────────────────────────────────────────
# REACT_APP_DEV_AUTH=    # leave unset
# REACT_APP_API_BASE_URL=https://your-backend.railway.app
