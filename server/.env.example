GOOGLE_CLIENT_ID=your_client_id
GOOGLE_CLIENT_SECRET=your_client_secret_from_google_cloud
CALLBACK_URL=http://localhost:5000/auth/google/callback

# Frontend URL used for CORS and OAuth redirects
# In production, set this to your deployed frontend URL
CLIENT_URL=http://localhost:3000

SESSION_SECRET=replace_with_random

# Google Workspace domain staff sign in with. Comma-separate several
# (school.org,district.org). Exact match: school.org does not admit
# staff.school.org. Required in production; unset in development accepts any
# domain (a Teacher record is still required).
ALLOWED_EMAIL_DOMAIN=yourschool.org

# IANA time zone the school runs on. Decides what "today" is and the times on
# calendar invites. Default America/New_York.
SCHOOL_TIME_ZONE=America/New_York

# PostgreSQL only. Omit DATABASE_URL to use the local SQLite file. Set it as a
# real environment variable or here; both work.
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# SSL is on by default. Set to false for a Postgres without SSL (same machine
# or private network).
# DB_SSL=false

# Must be exactly 'production' in deployment: it enables secure/cross-site session
# cookies. Leave as 'development' locally.
NODE_ENV=development

# Reverse-proxy hops to trust. LEAVE THIS UNSET unless you have a specific reason --
# the default of 1 is correct behind a single proxy or platform edge. It must be a whole number if set; a blank
# or non-numeric value would disable proxy trust, which stops secure session cookies
# from being issued and silently breaks every new login.
# TRUST_PROXY=1

PORT=5000

# Admin "Download full report" button. Set these on the BACKEND service only -
# never on the frontend, whose variables are compiled into the browser bundle.
# The Kotlin report runs as its own service (tutoring-analytics-report);
# use its PRIVATE network address, and the same
# REPORT_TOKEN value set on that service. Unset = the button says the report
# service isn't configured.
# REPORT_SERVICE_URL=http://tutoring-analytics-report.internal:8080
# REPORT_TOKEN=replace_with_long_random_string
